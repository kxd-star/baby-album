# Production mode refuses to start with an insecure SESSION_SECRET.
APP_ENV=production

# Volcengine Ark / compatible chat completion config
ARK_API_KEY=your_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Use a vision-capable model for image captions and photo-aware recommendations.
ARK_VISION_MODEL=ep-your-vision-model

# Text-only model for storyline generation and recommendation fallback.
ARK_TEXT_MODEL=ep-your-text-model

# MiniMax is preferred when configured; ARK remains available as fallback.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# Public URL used in uploaded-photo responses.
PUBLIC_BASE_URL=https://your-domain.example
FRONTEND_API_BASE_URL=

# Upload limits: 20MB per photo, 3 photos per request, about 64MB total.
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=30
MAX_USER_UPLOAD_FILES=300
MAX_UPLOAD_BATCH_FILES=3
MAX_REQUEST_BODY_BYTES=67108864
CAPTION_CONCURRENCY=4

# Vision calls read originals from local/S3 storage and compress large images in memory.
AI_IMAGE_COMPRESS_THRESHOLD=1048576
AI_IMAGE_MAX_SIDE=1280
AI_IMAGE_JPEG_QUALITY=82
AI_IMAGE_MAX_PIXELS=40000000
AI_IMAGE_CONCURRENCY=2
VISION_TIMEOUT_SECONDS=45
TEXT_TIMEOUT_SECONDS=45

# Use a concrete origin in production. "*" disables credentialed cross-origin sessions.
ALLOWED_ORIGINS=*

# Anonymous user isolation. Set a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=31536000
SIGNED_ASSET_TTL=600

# --- Storage Backend ---
# Leave S3_BUCKET empty to store files in the local uploads/ directory.
# S3-compatible storage (Cloudflare R2, AWS S3, Aliyun OSS, MinIO, etc.).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_KEY_PREFIX=uploads
# Redirect authorized reads to short-lived S3 URLs instead of proxying image bytes.
S3_PRESIGNED_READ=true
