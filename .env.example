# Volcengine Ark / compatible chat completion config
ARK_API_KEY=your_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Use a vision-capable model for image captions and photo-aware recommendations.
ARK_VISION_MODEL=ep-your-vision-model

# Text-only model for storyline generation and recommendation fallback.
ARK_TEXT_MODEL=ep-your-text-model

# Required for production vision calls when uploaded images are returned as /uploads/xxx.
# The model provider must be able to reach this URL. For local development, use a public
# tunnel such as ngrok/cloudflared, or image-vision calls will fall back to local captions.
PUBLIC_BASE_URL=https://your-domain.example
FRONTEND_API_BASE_URL=

# Upload limits and parallel caption generation.
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_FILES=30
MAX_REQUEST_BODY_BYTES=33554432
CAPTION_CONCURRENCY=4

# Use a concrete origin in production. "*" disables credentialed cross-origin sessions.
ALLOWED_ORIGINS=*

# Anonymous user isolation. Set a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=31536000
SIGNED_ASSET_TTL=600

# Optional S3-compatible persistent storage (Cloudflare R2, AWS S3, Aliyun OSS, etc.).
# Leave S3_BUCKET empty to store files in the local uploads/ directory.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_KEY_PREFIX=uploads
